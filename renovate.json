{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Renovate Dependency Dashboard",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "esphome-version:\\s*\\n(?:[ \\t]*- stable\\n)?(?<depValues>([ \\t]*- (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n)+)"
      ],
      "depNameTemplate": "ghcr.io/esphome/esphome",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "esphome-version:\\s+(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/esphome/esphome",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "source:\\s+github://the78mole/esphome_components@(?<currentValue>[^\\s\\n]+)"
      ],
      "depNameTemplate": "the78mole/esphome_components",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Alles Nicht-Major in einen Sammel-PR: ein PR, ein CI-Lauf, ein Merge, ein Release - statt vier Releases für vier Einzel-PRs. Majors bleiben einzeln, damit sie Aufmerksamkeit bekommen.",
      "groupName": "Dependencies (non-major)",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ]
    },
    {
      "description": "Ein Major der eigenen Komponenten-Library bekommt weiterhin einen eigenen PR, weil er die Firmware-Quelle wechselt und einzeln geprüft werden soll. Minor und Patch laufen über den Sammel-PR oben.",
      "matchPackageNames": [
        "the78mole/esphome_components"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "groupName": "ESPHome Components Update (major)",
      "matchUpdateTypes": [
        "major"
      ]
    }
  ]
}
